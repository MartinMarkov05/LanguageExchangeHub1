
@model LanguageExchangeHub1.Services.Models.Courses.CourseViewModel



<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    

       <h1>@Model.Name</h1>
        <button class="General" onclick="showCourseChatPage()">General</button>
    <button class="Assignements" onclick="showCourseAssignementPage()">Assignements</button>
    
</nav>
<div class="ChatPage">
    <div class="Chat-LeftSide"></div>
<div class="Chat-RightSide">
    <nav class="nav-rightSide">

        <button id="members" onclick="showMembers()">Members</button>
        <button id="requests" onclick="showRequests()">Requests</button>

    </nav>
    <div class="membersList">
        @{
            foreach (var item in Model.Members)
            {
                <div class="member-card">@item.Username</div>
            }
        }
    </div>

    <div class="requestList">
        @{
            if (!(Model.Requests == null))
            {
                foreach (var item in Model.Requests)
                {
                    <div class="request-card">

                        <div>@item.Username</div>
                        <button asp-action="SetStatus">Accept</button>
                        <button asp-action="SetStatus">Reject</button>


                    </div>
                    <div class="member-card">@item.Username</div>
                }
            }

        }
    </div>
</div>
    
</div>

<div class="AssignementsPage">

</div>


<script>
    function showMembers() {
        document.getElementsByClassName('membersList').style.display = 'block';
    }

    function showCourseChatPage() {
        var chatpage = document.getElementsByClassName("ChatPage");
        chatpage.style.display = 'block';
        document.getElementsByClassName('AssignementsPage').style.display = 'hidden';
    }

    function showCourseAssignementPage() {
        document.getElementsByClassName('AssignementsPage').style.display = 'block';
        document.getElementsByClassName('ChatPage').style.display = 'hidden';
    }
</script>